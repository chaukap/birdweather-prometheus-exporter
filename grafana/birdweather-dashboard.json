      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 31 },
      "id": 13,
      "options": {
        "alignValue": "center",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "birdweather_query_success",
          "legendFormat": "PUC link",
          "refId": "A"
        }
      ],
      "title": "🛰️ PUC Link History",
      "type": "state-timeline"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["birdweather", "birds", "prometheus"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "🐦 BirdWeather — Backyard Birds",
  "uid": "birdweather-backyard",
  "weekStart": ""
