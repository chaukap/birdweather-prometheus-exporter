        "y": 4
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Last heard"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(15, birdweather_species_latest_detection_timestamp_seconds) * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udd51 Recent Visitors",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "species_id": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Last heard",
              "scientific_name": "Scientific name",
              "species": "Bird"
            }
          }
        }
      ],
      "type": "table"
    },
